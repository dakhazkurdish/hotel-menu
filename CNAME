        subtitle: 'مێنیوی دیجیتالی و خزمەتگوزاریەکانی ژوور',
        cats: ['هەمووی', 'ژوورەکانی هۆتێل', 'بەیانیان', 'خواردنی سەرەکی', 'خواردنەوەکان', 'شیرینی'],
        items: [
          { cat: 1, title: 'ژووری تاک (Single Room)', desc: 'تەختێکی گەورە، وای فای، شاشەی 4K، فێنککەرەوە، بەیانیانی بێبەرامبەر', price: '45,000 IQD / شەو' },
          { cat: 1, title: 'ژووری دوو کەسی (Double Room)', desc: 'دوو تەخت یان تەختێکی دوو کەسی، مینی بار، دیمەنێکی جوان', price: '70,000 IQD / شەو' },
          { cat: 1, title: 'سوئێتی شاهانە (VIP Suite)', desc: 'دوو ژوور لەگەڵ هۆڵێک، جاکوزی، خزمەتگوزاری تایبەت 24/7', price: '120,000 IQD / شەو' },
          { cat: 2, title: 'بەیانیانی شاهانە', desc: 'پەنیر، هێلکە، هەنگوین، زەیتون، کەرە و چا', price: '8,000 IQD' },
