          { cat: 1, title: 'ژوورا جووت (Double Room)', desc: 'دوو تەخت یان تەختەکێ دوو کەسی، مینی بار، دیمەنەکێ جوان', price: '70,000 IQD / شەڤ' },
          { cat: 1, title: 'سوئێتا شاهانە (VIP Suite)', desc: 'دوو ژوور دگەل هۆلەکێ، جاكوزی، خزمەتگوزارییا تایبەت 24/7', price: '120,000 IQD / شەڤ' },
          
          // بەشێن خوارنێ
          { cat: 2, title: 'تاشتێیا شاهانە', desc: 'پەنێر، هێلك، هه‌نگڤین، زەیتوون، کەرە و چای', price: '8,000 IQD' },
