<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hotel Digital Menu & Rooms</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --accent-color: #f59e0b;
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
      --success-color: #22c55e;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      margin: 0;
      padding: 16px;
      -webkit-tap-highlight-color: transparent;
    }

    .lang-switcher {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-bottom: 15px;
      flex-wrap: wrap;
    }

    .lang-btn {
      background: transparent;
      border: 1px solid var(--accent-color);
      color: var(--accent-color);
      padding: 6px 14px;
      border-radius: 14px;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .lang-btn.active {
      background: var(--accent-color);
      color: #000;
      font-weight: bold;
    }

    header {
      text-align: center;
      padding: 10px 0 15px;
    }

    header h1 {
      margin: 0;
      font-size: 1.6rem;
      color: var(--accent-color);
    }

    header p {
      color: var(--text-sub);
      margin-top: 4px;
      font-size: 0.85rem;
    }

    .categories {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 10px 0 15px;
      -webkit-overflow-scrolling: touch;
    }

    .cat-btn {
      background: var(--card-bg);
      border: 1px solid #334155;
      color: var(--text-main);
      padding: 8px 16px;
      border-radius: 20px;
      white-space: nowrap;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .cat-btn.active {
      background: var(--accent-color);
      color: #000;
      font-weight: bold;
      border-color: var(--accent-color);
    }

    .menu-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .item-card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 1px solid #334155;
    }

    .item-details h3 {
      margin: 0 0 6px 0;
      font-size: 1rem;
    }

    .item-details p {
      margin: 0;
      font-size: 0.8rem;
      color: var(--text-sub);
      line-height: 1.3;
    }

    .price {
      font-weight: bold;
      color: var(--accent-color);
      font-size: 0.95rem;
      white-space: nowrap;
      margin-inline-start: 12px;
      text-align: end;
    }

    /* بەشێ پەیوەندییکرنێ (Contact Section) */
    footer.contact-section {
      margin-top: 35px;
      padding-top: 20px;
      border-top: 1px solid #334155;
    }

    .contact-title {
      text-align: center;
      font-size: 1.2rem;
      color: var(--accent-color);
      margin-bottom: 15px;
    }

    .contact-grid {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .contact-card {
      background: var(--card-bg);
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: var(--text-main);
      transition: background 0.2s;
    }

    .contact-card:active {
      background: #334155;
    }

    .contact-icon {
      font-size: 1.4rem;
      width: 32px;
      text-align: center;
    }

    .contact-info strong {
      display: block;
      font-size: 0.9rem;
    }

    .contact-info p {
      margin: 2px 0 0 0;
      font-size: 0.8rem;
      color: var(--text-sub);
    }

    .wa-card {
      border-color: #166534;
    }
    .wa-card .contact-info strong {
      color: var(--success-color);
    }
  </style>
</head>
<body>

  <!-- دکما هەڵبژارتنا زمانان -->
  <div class="lang-switcher">
    <button class="lang-btn active" onclick="changeLang('bad', this)">بادینی</button>
    <button class="lang-btn" onclick="changeLang('sor', this)">سۆرانی</button>
    <button class="lang-btn" onclick="changeLang('ar', this)">العربية</button>
    <button class="lang-btn" onclick="changeLang('en', this)">English</button>
  </div>

  <header>
    <h1 id="hotel-name">هۆتێلا مەیپڵ</h1>
    <p id="hotel-subtitle">مێنیویا دیجیتالی و خزمەتگوزاریێن ژووران</p>
  </header>

  <!-- بەشێن سەرەکی -->
  <div class="categories" id="cat-list"></div>

  <!-- لیستایا خوارن و ژووران -->
  <div class="menu-container" id="menu-items"></div>

  <!-- بەشێ پەیوەندییکرنێ -->
  <footer class="contact-section">
    <div class="contact-title" id="contact-heading">پەیوەندی و ناڤنیشان</div>
    <div class="contact-grid">
      
      <!-- تەلەفۆنا ڕێسێپشنێ -->
      <a href="tel:+9647500000000" class="contact-card">
        <span class="contact-icon">📞</span>
        <div class="contact-info">
          <strong id="label-phone">ڕێسێپشنا هۆتێلێ</strong>
          <p dir="ltr">+964 750 000 0000</p>
        </div>
      </a>

      <!-- واتساپ -->
      <a href="https://wa.me/9647500000000" target="_blank" class="contact-card wa-card">
        <span class="contact-icon">💬</span>
        <div class="contact-info">
          <strong id="label-wa">پەیوەندیا واتساپێ</strong>
          <p id="sub-wa">بۆ داواکاری و خزمه‌تگوزارییان</p>
        </div>
      </a>

      <!-- ناڤنیشان -->
      <div class="contact-card">
        <span class="contact-icon">📍</span>
        <div class="contact-info">
          <strong id="label-location">ناڤنیشان</strong>
          <p id="val-location">کوردستان، دهۆک - جاددا سەنتەری</p>
        </div>
      </div>

    </div>
  </footer>

