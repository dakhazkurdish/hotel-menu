        cats: ['الكل', 'غرف الفندق', 'الإفطار', 'الأطباق الرئيسية', 'المشروبات', 'الحلويات'],
        items: [
          { cat: 1, title: 'غرفة مفردة (Single Room)', desc: 'سرير كبير، واي فاي، شاشة 4K، تكييف، إفطار مجاني', price: '45,000 IQD / ليلة' },
          { cat: 1, title: 'غرفة مزدوجة (Double Room)', desc: 'سريران أو سرير لشخصين، ميني بار، إطلالة جميلة', price: '70,000 IQD / ليلة' },
          { cat: 1, title: 'جناح ملكي (VIP Suite)', desc: 'غرفتان مع صالة، جاكوزي، خدمة خاصة 24/7', price: '120,000 IQD / ليلة' },
          { cat: 2, title: 'إفطار ملكي', desc: 'جبنة، بيض، عسل، زيتون، زبدة، وشاي', price: '8,000 IQD' },
          { cat: 3, title: 'كباب خاص', desc: 'لحم ضأن مع أرز وسلطة', price: '14,000 IQD' },
          { cat: 4, title: 'كابوتشينو', desc: 'قهوة طازجة مع حليب', price: '4,000 IQD' },
          { cat: 5, title: 'كيك الشوكولاتة', desc: 'كيك ساخن مع آيس كريم', price: '5,000 IQD' }
        ],
        contactTitle: 'التواصل والعنوان',
        phoneLabel: 'استقبال الفندق',
        waLabel: 'تواصل عبر الواتساب',
        waSub: 'للطلبات والخدمات',
        locLabel: 'العنوان',
        locVal: 'كردستان، دهوك - شارع المركز'
      },
      en: {
        dir: 'ltr',
        title: 'Maple Hotel',
        subtitle: 'Digital Menu & Room Services',
        cats: ['All', 'Hotel Rooms', 'Breakfast', 'Main Dishes', 'Drinks', 'Desserts'],
        items: [
          { cat: 1, title: 'Single Room', desc: 'Queen bed, Free Wi-Fi, 4K TV, AC, Free Breakfast included', price: '$35 / Night' },
          { cat: 1, title: 'Double Room', desc: 'Twin beds or King bed, Mini-bar, City View', price: '$50 / Night' },
          { cat: 1, title: 'VIP Suite', desc: '2 Bedrooms + Living room, Jacuzzi, 24/7 Room Service', price: '$90 / Night' },
          { cat: 2, title: 'Royal Breakfast', desc: 'Cheese, eggs, honey, olives, butter, and tea', price: '$6.00' },
          { cat: 3, title: 'Special Kebab', desc: 'Lamb meat served with rice and salad', price: '$10.00' },
          { cat: 4, title: 'Cappuccino', desc: 'Fresh espresso with steamed milk', price: '$3.00' },
          { cat: 5, title: 'Chocolate Cake', desc: 'Warm cake with vanilla ice cream', price: '$4.00' }
        ],
        contactTitle: 'Contact & Location',
        phoneLabel: 'Hotel Reception',
        waLabel: 'WhatsApp Contact',
        waSub: 'For orders and inquiries',
        locLabel: 'Address',
        locVal: 'Kurdistan, Duhok - Center Street'
      }
    };

    function renderMenu() {
      const selected = data[currentLang];
      document.documentElement.dir = selected.dir;

      document.getElementById('hotel-name').innerText = selected.title;
      document.getElementById('hotel-subtitle').innerText = selected.subtitle;

      // بەشێ پەیوەندیان
      document.getElementById('contact-heading').innerText = selected.contactTitle;
      document.getElementById('label-phone').innerText = selected.phoneLabel;
      document.getElementById('label-wa').innerText = selected.waLabel;
      document.getElementById('sub-wa').innerText = selected.waSub;
      document.getElementById('label-location').innerText = selected.locLabel;
      document.getElementById('val-location').innerText = selected.locVal;

      // پۆلێنکرنا بەشان
      const catContainer = document.getElementById('cat-list');
      catContainer.innerHTML = selected.cats.map((c, i) => 
        `<button class="cat-btn ${i === activeCatIndex ? 'active' : ''}" onclick="selectCategory(${i})">${c}</button>`
      ).join('');

      // فلتەرکرنا ئایتمان
      const filteredItems = activeCatIndex === 0 
        ? selected.items 
        : selected.items.filter(item => item.cat === activeCatIndex);

      const itemContainer = document.getElementById('menu-items');
      itemContainer.innerHTML = filteredItems.map(item => `
        <div class="item-card">
          <div class="item-details">
            <h3>${item.title}</h3>
            <p>${item.desc}</p>
          </div>
          <div class="price">${item.price}</div>
        </div>
      `).join('');
    }

    function selectCategory(index) {
      activeCatIndex = index;
      renderMenu();
    }

    function changeLang(lang, el) {
      currentLang = lang;
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      if(el) el.classList.add('active');
      renderMenu();
    }

    document.addEventListener("DOMContentLoaded", function() {
      renderMenu();
    });
  </script>
</body>
</html>
